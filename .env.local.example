# For `npm run dev` only. See STACK.md → Environment configuration.
#
# Supabase — copy to .env.local and fill in values from your Supabase project dashboard.
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — used for dev-only verification link logging
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — signed Storage URLs and admin CRUD (never expose publicly)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (Resend) — download verification + contact notifications
# Variable names must match Cloudflare: RESEND_API_KEY (secret), EMAIL_FROM (plain text).
RESEND_API_KEY=
# Resend onboarding / testing: onboarding@resend.dev (see Resend docs for allowed recipients)
# Production (after domain verification): HGV Intelligence <hello@your-verified-domain.co.uk>
EMAIL_FROM=
# Inbox for contact-form alerts (recommended in production; omit to skip staff email)
NOTIFY_EMAIL=

# Sole administrator (must match Supabase Auth user email)
ADMIN_EMAIL=admin@example.com

# Cloudflare Workers preview (copy same Supabase values to .dev.vars — see .dev.vars.example)
