# For `npm run dev` only. See STACK.md → Environment configuration.
#
# Supabase — copy to .env.local and fill in values from your Supabase project dashboard.
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — used for dev-only verification link logging
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — signed Storage URLs and admin CRUD (never expose publicly)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (Resend) — verification + enquiry notifications
RESEND_API_KEY=
EMAIL_FROM=HGV Intelligence <hello@hgvintelligence.co.uk>
NOTIFY_EMAIL=hello@hgvintelligence.co.uk

# Sole administrator (must match Supabase Auth user email)
ADMIN_EMAIL=admin@example.com

# Cloudflare Workers preview (copy same Supabase values to .dev.vars — see .dev.vars.example)
