# Copy to .dev.vars for `npm run preview` / Wrangler local dev.
# Same values as .env.local for Supabase.

NEXTJS_ENV=development
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:8787
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=
EMAIL_FROM=HGV Intelligence <hello@hgvintelligence.co.uk>
NOTIFY_EMAIL=hello@hgvintelligence.co.uk
ADMIN_EMAIL=admin@example.com
