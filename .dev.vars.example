# For `npm run preview` / Wrangler local dev only. See STACK.md → Environment configuration.
# Copy to .dev.vars (gitignored). Use the same variable names as Cloudflare Production; use local URLs for NEXT_PUBLIC_SITE_URL.
# NEXTJS_ENV is preview-only — not used on Cloudflare Workers.

NEXTJS_ENV=development
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:8787
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=
EMAIL_FROM=HGV Intelligence <hello@hgvintelligence.co.uk>
NOTIFY_EMAIL=hello@hgvintelligence.co.uk
ADMIN_EMAIL=admin@example.com
